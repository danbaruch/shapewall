{
  "name": "shapewall-website",
  "version": "0.0.0",
  "private": true,
  "description": "The Shapewall marketing and docs site (shapewall.com), prerendered to static HTML.",
  "license": "Apache-2.0",
  "author": "Dan Baruch",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js contact/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "marked": "^18.1.3",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
