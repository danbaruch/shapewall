# Shapewall marketing site (danbaruch/shapewall website/), public. Releases: /var/www/shapewall.com/releases, current/previous.
# The live demo is a static Shapewall export in each release's demo/ folder (scripts/demo-export.js), served at /demo/.
# Mirrors website/deploy/shapewall.Caddyfile in the shapewall repo.
shapewall.com {
    root * /var/www/shapewall.com/current
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    # Deferred default: a narrower shell policy below takes precedence.
    header ?Permissions-Policy "camera=(), microphone=(), geolocation=()"
    header Strict-Transport-Security "max-age=31536000"
    # no-transform: Cloudflare (proxying this zone) then injects nothing into pages, e.g. its analytics beacon, which the site's and
    # the demo board's CSP block anyway (a console error on every page) and the demo's sandboxed snapshots must never carry.
    header ?Cache-Control "public, max-age=0, must-revalidate, no-transform"
    @bundles path /assets/* /demo/assets/*
    header @bundles Cache-Control "public, max-age=31536000, immutable"
    @versioned path /og/* /covers/*
    header @versioned Cache-Control "public, max-age=86400"
    @sw path /sw.js /demo/sw.js
    header @sw Cache-Control "no-cache, no-store, must-revalidate"
    @manifest path /manifest.webmanifest /demo/manifest.webmanifest
    header @manifest Content-Type application/manifest+json

    # The site: never framed.
    @site not path /demo /demo/*
    header @site X-Frame-Options DENY
    header @site Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"

    # The demo board (same policy as `shapewall serve`); it frames its own live HTML snapshots, which get the
    # snapshot policy: no scripts at all, inline styles and data: images only, framed only by this origin.
    # Not indexed, whatever the site's stealth setting.
    # The natural read-aloud voice's worker scripts (assets/tts-*.js|mjs) get their own policy instead: they compile WebAssembly and
    # download the Kokoro model and voices from Hugging Face. A dedicated worker takes its CSP from its own script, so the board page
    # itself keeps connect-src 'self'. The voice runs in the visitor's browser; nothing is sent to shapewall.com.
    @demoShell {
        path /demo /demo/*
        not path_regexp ^/demo/(data/.*\.html|assets/tts-[^/]*\.m?js)$
    }
    @demoTts path_regexp ^/demo/assets/tts-[^/]*\.m?js$
    @demoLive path_regexp ^/demo/data/.*\.html$
    @demo path /demo /demo/*
    header @demo X-Robots-Tag "noindex, nofollow"
    # Dictation belongs to the top-level board, never captured pages or workers.
    @demoVoice path /demo /demo/ /demo/index.html /demo/console.html
    header @demoVoice Permissions-Policy "camera=(), microphone=(self), geolocation=()"
    header @demoTts Permissions-Policy "camera=(), microphone=(), geolocation=()"
    header @demoLive Permissions-Policy "camera=(), microphone=(), geolocation=()"
    header @demoShell X-Frame-Options DENY
    header @demoShell Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
    header @demoTts Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://huggingface.co https://*.hf.co; base-uri 'none'; form-action 'none'"
    header @demoLive X-Frame-Options SAMEORIGIN
    header @demoLive Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"

    # /sand/ -> /sand, /index.html and /sand.html -> clean URLs (one URL per page), keeping any query string.
    # Not under /demo/: the board uses relative URLs, so it needs /demo/ with the slash, and real .html files.
    @slash {
        path_regexp slash ^/(.+)/$
        not path /demo/*
    }
    @index path /index.html
    @htmlPage {
        path_regexp html ^/(.+)\.html$
        not path /404.html /google*.html /demo/*
    }
    @retiredRoadmap path /roadmap /roadmap/ /roadmap.html
    redir @retiredRoadmap /features{?query} permanent
    redir /demo /demo/{?query} permanent
    redir @slash /{re.slash.1}{?query} permanent
    redir @index /{?query} permanent
    redir @htmlPage /{re.html.1}{?query} permanent

    @umamiScript path /umami/script.js /umami/api/send
    handle @umamiScript {
        uri strip_prefix /umami
        reverse_proxy 127.0.0.1:3006
    }
    handle /demo/* {
        file_server
    }
    handle {
        try_files {path} {path}.html
        file_server
    }
    # errors are never cached (a bundle missing mid-rollout must not stick as an immutable 404)
    handle_errors 404 {
        root * /var/www/shapewall.com/current
        header Cache-Control "no-store"
        rewrite * /404.html
        file_server
    }
    handle_errors {
        header Cache-Control "no-store"
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}
www.shapewall.com {
    redir https://shapewall.com{uri} permanent
}
journeypane.com, www.journeypane.com {
    redir https://shapewall.com{uri} permanent
}
