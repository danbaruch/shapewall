# Push-first hosted server: no browser installation or capture worker.
# The base image is pinned to one Node.js release; raise it on purpose.
FROM node:22.23.5-bookworm-slim AS build
WORKDIR /opt/shapewall
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
# @sentry/node is an optional peer dependency (error reports, opt-in with
# SHAPEWALL_ERROR_DSN), not installed with Shapewall: the image includes it.
RUN npm run build && npm prune --omit=dev --ignore-scripts --no-audit --no-fund \
  && npm install --no-save --omit=dev --ignore-scripts --no-audit --no-fund @sentry/node@11.12.0

FROM node:22.23.5-bookworm-slim
ENV NODE_ENV=production HOME=/tmp
WORKDIR /opt/shapewall
COPY --from=build /opt/shapewall/package.json ./
COPY --from=build /opt/shapewall/LICENSE /opt/shapewall/NOTICE /opt/shapewall/THIRD_PARTY.md ./
COPY --from=build /opt/shapewall/bin ./bin
COPY --from=build /opt/shapewall/src ./src
COPY --from=build /opt/shapewall/dist ./dist
COPY --from=build /opt/shapewall/node_modules ./node_modules
RUN chmod -R a+rX,go-w /opt/shapewall && install -d -o node -g node -m 0700 /data
USER node
EXPOSE 4700
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:4700/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
ENTRYPOINT ["node", "/opt/shapewall/bin/shapewall.js"]
CMD ["hosted", "--host", "0.0.0.0", "--port", "4700", "--data", "/data"]
