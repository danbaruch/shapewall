# Push-first hosted server: no browser installation or capture worker.
FROM node:22-bookworm-slim AS build
WORKDIR /opt/shapewall
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /opt/shapewall
COPY --from=build /opt/shapewall/package.json ./
COPY --from=build /opt/shapewall/bin ./bin
COPY --from=build /opt/shapewall/src ./src
COPY --from=build /opt/shapewall/dist ./dist
COPY --from=build /opt/shapewall/node_modules ./node_modules
USER node
EXPOSE 4700
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:4700/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
ENTRYPOINT ["node", "/opt/shapewall/bin/shapewall.js"]
CMD ["hosted", "--host", "0.0.0.0", "--port", "4700", "--data", "/data"]
