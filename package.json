{
  "name": "shapewall",
  "version": "0.3.0",
  "description": "Every page of your site on one zoomable wall: desktop and phone captures, sandboxed live HTML, and element-anchored comments your coding agent can read.",
  "license": "Apache-2.0 AND FSL-1.1-ALv2",
  "author": "Dan Baruch",
  "homepage": "https://shapewall.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbaruch/shapewall.git"
  },
  "bugs": {
    "url": "https://github.com/danbaruch/shapewall/issues"
  },
  "type": "module",
  "bin": {
    "shapewall": "bin/shapewall.js"
  },
  "files": [
    "bin",
    "src",
    "dist/client",
    "dist/console",
    "dist/agent",
    "examples/audits/interaction.audit.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY.md",
    "CHANGELOG.md",
    "Dockerfile.agent",
    "docs/agent-hardening.md",
    "docs/agent-recipes.md",
    "docs/agent-workflow.md",
    "docs/agents.md",
    "docs/buzz.md",
    "docs/architecture.md",
    "docs/capture-warnings.md",
    "docs/config.md",
    "docs/deployment.md",
    "docs/design-system.md",
    "docs/github.md",
    "docs/hosted.md",
    "docs/interaction-audits.md",
    "docs/journeys.md",
    "docs/local-accounts.md",
    "docs/notifications.md",
    "docs/page-checks.md",
    "docs/pull-requests.md",
    "docs/performance.md",
    "docs/starter-agent.md",
    "docs/updates.md",
    "docs/images"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.console.config.js",
    "build:demo": "vite build -c vite.demo.config.js",
    "dev:console": "vite -c vite.console.config.js",
    "prepare": "npm run build && npm run prepack",
    "prepack": "node -e \"const fs=require('fs');fs.mkdirSync('dist/agent',{recursive:true});fs.copyFileSync('package-lock.json','dist/agent/package-lock.json')\"",
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pack": "node scripts/check-pack.js",
    "fresh-install": "bash scripts/fresh-install.sh",
    "demo": "node scripts/demo.js",
    "demo:capture": "node scripts/demo.js --capture-only",
    "pretest": "node -e \"require('fs').rmSync('test/.output',{recursive:true,force:true})\""
  },
  "keywords": [
    "screenshots",
    "design-review",
    "visual-review",
    "visual-feedback",
    "website-review",
    "feedback",
    "comments",
    "playwright",
    "ai-agents",
    "coding-agent",
    "mcp",
    "claude-code",
    "codex",
    "self-hosted",
    "react-flow"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.4.0",
    "@scure/base": "2.4.0",
    "@simplewebauthn/server": "14.0.3",
    "axe-core": "4.14.0",
    "chrome-launcher": "1.2.2",
    "express": "5.3.0",
    "lighthouse": "13.6.0",
    "parse5": "8.1.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.16.0",
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@titan-design/speech-g2p": "0.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.67.0",
    "onnxruntime-web": "1.31.1",
    "phonemize": "2.0.1",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
